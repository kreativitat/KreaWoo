#!/bin/sh
set -eu

project_root=$(git rev-parse --show-toplevel)
scanner=$(git config --get gitleaks.path || printf '%s' gitleaks)
if ! command -v "$scanner" >/dev/null 2>&1; then
    printf '%s\n' 'Install Gitleaks 8.30.1 before pushing. See SECURITY.md.' >&2
    exit 1
fi
cd "$project_root"
python3 scripts/check_publication.py --range=--all
"$scanner" dir . --config=.gitleaks.toml --redact=100 --no-banner \
    --ignore-gitleaks-allow --max-archive-depth=3 --max-decode-depth=3
"$scanner" git . --config=.gitleaks.toml --log-opts='--full-history -m --all' \
    --redact=100 --no-banner --ignore-gitleaks-allow \
    --max-archive-depth=3 --max-decode-depth=3
